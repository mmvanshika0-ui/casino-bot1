# ── Core ────────────────────────────────────────────
DISCORD_TOKEN=your_discord_bot_token
DATABASE_URL=file:./dev.db

# ── Admin ────────────────────────────────────────────
ADMIN_IDS=discord_user_id_1,discord_user_id_2
ADMIN_ROLE_ID=your_admin_role_id

# ── Economy ──────────────────────────────────────────
STARTING_BALANCE=5000
DAILY_REWARD=1000
HOUSE_EDGE=0.03

# ── Crypto (Apirone) ─────────────────────────────────
APIRONE_API_KEY=your_apirone_key
APIRONE_ACCOUNT=your_apirone_account
APIRONE_CALLBACK_URL=https://yourdomain.com/callback

# ── Notifications ─────────────────────────────────────
# Channel ID where big wins, jackpots, leaderboard changes are posted
NOTIFICATIONS_CHANNEL_ID=your_channel_id

# ── Big Win Threshold ─────────────────────────────────
# Multiplier at which a win triggers a notification (default: 10)
BIG_WIN_THRESHOLD=10

# ── Casino Lounge ─────────────────────────────────────
# Channel ID for the .chat command global lounge
CASINO_LOUNGE_CHANNEL_ID=your_lounge_channel_id

# ── Callback Server ───────────────────────────────────
CALLBACK_PORT=3000

# ── Guild ID (for role assignment on rank-up) ─────────
GUILD_ID=your_main_guild_id

# ── Rank Role IDs (create these roles in Discord first) ─
# Assign each role ID to its rank. Bot needs Manage Roles permission.
RANK_ROLE_BRONZE=discord_role_id_for_bronze
RANK_ROLE_SILVER=discord_role_id_for_silver
RANK_ROLE_GOLD=discord_role_id_for_gold
RANK_ROLE_PLATINUM=discord_role_id_for_platinum
RANK_ROLE_DIAMOND=discord_role_id_for_diamond
RANK_ROLE_OBSIDIAN=discord_role_id_for_obsidian
